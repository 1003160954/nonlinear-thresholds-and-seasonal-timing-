# -*- coding: utf-8 -*-
"""
Figure 3-style plot:
(a) Distribution of city-level mean EVI
(b) Distribution of city-level high-greenness fraction, defined as proportion of EVI >= 0.4
(c) Relationship between city-level mean EVI and high-greenness fraction

This script reads the final ALLCITIES npz modelling dataset and computes city-level EVI statistics.
"""

import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# 1. User settings
# ============================================================

NPZ_PATH = "/content/drive/MyDrive/anature_revised/ALLCITIES_train_xy_monthly_S10_40pct_ntlmask_TOP100.npz"

OUT_DIR = "/content/drive/MyDrive/anature_revised/fig3_evi_threshold"
os.makedirs(OUT_DIR, exist_ok=True)

OUT_CSV = os.path.join(OUT_DIR, "city_level_EVI_threshold_statistics_EVIge04.csv")
OUT_FIG = os.path.join(OUT_DIR, "Fig3_city_EVI_threshold_EVIge04.png")
OUT_FIG_PDF = os.path.join(OUT_DIR, "Fig3_city_EVI_threshold_EVIge04.pdf")

# Final manuscript benchmark
EVI_THRESHOLD = 0.4

# Histogram bins
EVI_BINS = np.linspace(0, 1, 21)
PROP_BINS = np.linspace(0, 1, 21)

# Optional filtering
MIN_SAMPLES_PER_CITY = 10

# Figure style
plt.rcParams["font.family"] = "Arial"
plt.rcParams["font.size"] = 10
plt.rcParams["axes.linewidth"] = 1.0
plt.rcParams["xtick.direction"] = "out"
plt.rcParams["ytick.direction"] = "out"


# ============================================================
# 2. Load NPZ data
# ============================================================

print("Loading:", NPZ_PATH)
data = np.load(NPZ_PATH, allow_pickle=True)

X = data["X"]
y = data["y"] if "y" in data.files else None
channels = data["channels"].tolist()
used_cities = data["used_cities"].tolist()

print("X shape:", X.shape)
print("Number of channels:", len(channels))
print("Number of used cities:", len(used_cities))

print("\nChannels:")
for i, ch in enumerate(channels):
    print(f"{i:03d}: {ch}")


# ============================================================
# 3. Locate EVI and city ID columns
# ============================================================

# Find EVI column robustly
evi_candidates = [
    i for i, ch in enumerate(channels)
    if ("EVI" in str(ch).upper()) and ("LST" not in str(ch).upper())
]

if len(evi_candidates) == 0:
    raise ValueError("No EVI column found in channels.")

# Prefer exact or common EVI channel names if available
preferred_evi_names = ["EVI.EVI", "EVI", "MODIS.EVI"]
evi_idx = None

for name in preferred_evi_names:
    if name in channels:
        evi_idx = channels.index(name)
        break

if evi_idx is None:
    evi_idx = evi_candidates[0]

# Find city ID column
city_id_candidates = [
    "META.CITY_ID",
    "CITY_ID",
    "city_id",
    "META.city_id"
]

city_idx = None
for name in city_id_candidates:
    if name in channels:
        city_idx = channels.index(name)
        break

if city_idx is None:
    raise ValueError("No city ID column found. Expected one of: META.CITY_ID, CITY_ID, city_id.")

print("\nSelected EVI column:", channels[evi_idx], "index =", evi_idx)
print("Selected city column:", channels[city_idx], "index =", city_idx)


# ============================================================
# 4. Build city-level table
# ============================================================

df = pd.DataFrame({
    "city_id": X[:, city_idx],
    "EVI": X[:, evi_idx]
})

# Clean values
df["city_id"] = pd.to_numeric(df["city_id"], errors="coerce")
df["EVI"] = pd.to_numeric(df["EVI"], errors="coerce")

df = df[np.isfinite(df["city_id"]) & np.isfinite(df["EVI"])].copy()

# Keep physically meaningful EVI range
# You can adjust this if your preprocessing already clipped EVI.
df = df[(df["EVI"] >= -0.2) & (df["EVI"] <= 1.0)].copy()

df["city_id"] = df["city_id"].astype(int)

print("\nValid sample number:", len(df))
print("City ID range:", df["city_id"].min(), "to", df["city_id"].max())


def city_name_from_id(city_id):
    city_id = int(city_id)
    if city_id < 0 or city_id >= len(used_cities):
        return f"Unknown_{city_id}"
    return str(used_cities[city_id])


city_stats = (
    df.groupby("city_id")
      .agg(
          mean_EVI=("EVI", "mean"),
          median_EVI=("EVI", "median"),
          std_EVI=("EVI", "std"),
          min_EVI=("EVI", "min"),
          max_EVI=("EVI", "max"),
          prop_EVI_ge04=("EVI", lambda x: float(np.mean(x >= EVI_THRESHOLD))),
          n_samples=("EVI", "size")
      )
      .reset_index()
)

city_stats["city"] = city_stats["city_id"].apply(city_name_from_id)

# Remove cities with too few samples
city_stats = city_stats[city_stats["n_samples"] >= MIN_SAMPLES_PER_CITY].copy()
city_stats = city_stats.sort_values("mean_EVI", ascending=False).reset_index(drop=True)

print("\nEffective cities:", len(city_stats))
print("\nTop 15 cities by mean EVI:")
print(city_stats[["city", "mean_EVI", "prop_EVI_ge04", "n_samples"]].head(15).to_string(index=False))

print("\n===== Global summary =====")
n_city = len(city_stats)
n_mean_ge_thr = int(np.sum(city_stats["mean_EVI"] >= EVI_THRESHOLD))
print(f"Number of cities: {n_city}")
print(f"Cities with mean EVI >= {EVI_THRESHOLD:.1f}: {n_mean_ge_thr} ({n_mean_ge_thr / n_city * 100:.2f}%)")

print("\nCity mean EVI statistics:")
print(city_stats["mean_EVI"].describe())

print(f"\nProportion of EVI >= {EVI_THRESHOLD:.1f} statistics:")
print(city_stats["prop_EVI_ge04"].describe())

city_stats.to_csv(OUT_CSV, index=False)
print("\nSaved city statistics:", OUT_CSV)


# ============================================================
# 5. Plot figure
# ============================================================

fig, axes = plt.subplots(1, 3, figsize=(13.8, 4.1))

bar_color = "#6BAED6"
edge_color = "#2F4F4F"
scatter_color = "#4C9ED9"

# ------------------------------------------------------------
# (a) Distribution of city mean EVI
# ------------------------------------------------------------
ax = axes[0]

ax.hist(
    city_stats["mean_EVI"],
    bins=EVI_BINS,
    color=bar_color,
    edgecolor=edge_color,
    linewidth=1.0,
    alpha=0.85
)

ax.axvline(
    EVI_THRESHOLD,
    color="red",
    linestyle="--",
    linewidth=1.2
)

ax.set_xlim(0, 1.0)
ax.set_ylim(bottom=0)
ax.set_xlabel("City-level mean EVI")
ax.set_ylabel("Number of cities")
ax.set_title("Distribution of City Mean EVI", pad=8)
ax.text(
    0.5, -0.27, "(a)",
    transform=ax.transAxes,
    ha="center", va="center",
    fontsize=11,
    fontweight="bold"
)

# ------------------------------------------------------------
# (b) Distribution of high-greenness area fraction
# ------------------------------------------------------------
ax = axes[1]

ax.hist(
    city_stats["prop_EVI_ge04"],
    bins=PROP_BINS,
    color=bar_color,
    edgecolor=edge_color,
    linewidth=1.0,
    alpha=0.85
)

ax.set_xlim(0, 1.0)
ax.set_ylim(bottom=0)
ax.set_xlabel(f"Proportion of EVI ≥ {EVI_THRESHOLD:.1f}")
ax.set_ylabel("Number of cities")
ax.set_title("High-Greenness Area Fraction", pad=8)
ax.text(
    0.5, -0.27, "(b)",
    transform=ax.transAxes,
    ha="center", va="center",
    fontsize=11,
    fontweight="bold"
)

# ------------------------------------------------------------
# (c) Greenness level vs high-green fraction
# ------------------------------------------------------------
ax = axes[2]

ax.scatter(
    city_stats["mean_EVI"],
    city_stats["prop_EVI_ge04"],
    s=28,
    color=scatter_color,
    edgecolor="white",
    linewidth=0.4,
    alpha=0.85
)

ax.axvline(
    EVI_THRESHOLD,
    color="red",
    linestyle="--",
    linewidth=1.2
)

ax.axhline(
    0.5,
    color="orange",
    linestyle="--",
    linewidth=1.2
)

# Adjust xlim based on data but keep a clean range like your example
x_min = max(0.0, np.floor(city_stats["mean_EVI"].min() * 10) / 10 - 0.02)
x_max = min(1.0, np.ceil(city_stats["mean_EVI"].max() * 10) / 10 + 0.02)

ax.set_xlim(x_min, x_max)
ax.set_ylim(-0.05, 1.0)
ax.set_xlabel("City Mean EVI")
ax.set_ylabel(f"Proportion EVI ≥ {EVI_THRESHOLD:.1f}")
ax.set_title("Greenness Level vs High-Green Fraction", pad=8)
ax.text(
    0.5, -0.27, "(c)",
    transform=ax.transAxes,
    ha="center", va="center",
    fontsize=11,
    fontweight="bold"
)

# ------------------------------------------------------------
# Shared styling
# ------------------------------------------------------------
for ax in axes:
    ax.grid(False)
    ax.tick_params(axis="both", which="major", labelsize=9)
    for spine in ax.spines.values():
        spine.set_linewidth(1.0)
        spine.set_color("#444444")

plt.subplots_adjust(wspace=0.32, bottom=0.24, top=0.86)

plt.savefig(OUT_FIG, dpi=600, bbox_inches="tight")
plt.savefig(OUT_FIG_PDF, bbox_inches="tight")
plt.show()

print("\nSaved figure:")
print(OUT_FIG)
print(OUT_FIG_PDF)
