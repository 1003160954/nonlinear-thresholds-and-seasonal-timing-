# Output paths
# ------------------------------------------------------------
OUT_DIR = "/content/drive/MyDrive/anature_revised/processed_dataset"
os.makedirs(OUT_DIR, exist_ok=True)

DATA_TAG = "LATEST1Y" if USE_LATEST_YEAR_ONLY else "MULTIYEAR_2013_2025"

