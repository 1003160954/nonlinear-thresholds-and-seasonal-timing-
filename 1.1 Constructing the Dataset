# ============================================================
# 0) Config
# ============================================================

ROOT = "/content/drive/MyDrive/anature_revised/data"

FINE_DEG = 0.005
ERA_DEG  = 0.10

# You can still use this knob for speed
SPATIAL_SUBSAMPLE = 1   # 4/6/8; larger -> much faster, coarser

SAMPLE_FRAC = 1.0
RANDOM_SEED = 42
CITY_LIMIT = 100
MIN_CITY_PIXELS = 20
CITY_WHITELIST = []

# ------------------------------------------------------------
# Temporal option
# ------------------------------------------------------------
# False = multi-year dataset, consistent with manuscript 2013–2025
# True  = latest available year only
USE_LATEST_YEAR_ONLY = False

# ------------------------------------------------------------
# Urban core via NTL
# ------------------------------------------------------------
USE_NTL_CORE = False
NTL_PCT_BRIGHTEST = 99
NTL_KEYS = {"NTL", "VIIRS", "NIGHT", "NIGHTLIGHT"}
NTL_MIN_ABS = 0.0

# ------------------------------------------------------------
# Target selection: daytime LST
# ------------------------------------------------------------
TARGET_PREFS = ("LST.LSTD", "LST.LST_DAY", "LST_DAY")
EXCLUDE_LST_FEATURES = True

# ------------------------------------------------------------
# Water handling
# ------------------------------------------------------------
WATER_CODE = 17
WATER_FRAC_THR = 0.3
REQUIRE_LAND_PIXEL = True

# ------------------------------------------------------------
# Validity mask requirements
# ------------------------------------------------------------
REQ_SUBSTRINGS = ["EVI", "LAI", "VPD", "SSRD", "T2M", "TD", "TP"]

# ------------------------------------------------------------
# Optional channel prefilter
# ------------------------------------------------------------
USE_CHANNEL_PREFILTER = True

KEEP_CHANNEL_SUBSTRINGS = [
    "EVI", "LAI",
    "T2M", "VPD", "SSRD", "TP", "TD",
    "LC",
    "NTL", "VIIRS", "NIGHT", "NIGHTLIGHT",
    "DEM", "SLOPE", "NDBI", "IMPERV", "BUILT", "URBAN",
    "WATERDIST", "DISTWATER",
]

ALWAYS_KEEP_TARGET_HINTS = ["LST"]

PRUNE_TRIPLES_EARLY = True
VERBOSE = True

